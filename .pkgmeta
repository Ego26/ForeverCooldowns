package-as: ForeverCooldowns

# Keine externen Bibliotheken: Forever Cooldowns nutzt ausschließlich
# Blizzard-API. Jede API wird einzeln auf Vorhandensein geprüft, damit das
# AddOn auf Classic-artigen und modernen Clients gleichermaßen läuft.
externals: {}

# Ohne diese Angabe baut der Packager die Release-Notes aus den Commit-Texten
# zusammen. Was bei CurseForge steht, soll hier stehen.
manual-changelog:
  filename: RELEASE-NOTES.md
  markup-type: markdown

# Nicht ins Release-Paket
ignore:
  - branding
  - Tests
  - .github
  - .editorconfig
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - README.md
  - README.en.md
  # Die Historie bleibt im Repository. Ins Paket geht RELEASE-NOTES.md mit
  # dem, was diese eine Version gebracht hat.
  - CHANGELOG.md
  - CHANGELOG.en.md
